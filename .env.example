# LeetCode cookies — auto-fill with: python scripts/extract_cookies.py
LEETCODE_SESSION=
LEETCODE_CSRFTOKEN=

# Language preference (optional) — tries this lang first, falls back to global best
# Options: java, python3, cpp, javascript, typescript, golang, csharp, ruby, rust, kotlin
PREFERRED_LANG=java

# GitHub — needed only for: python scripts/push_cookies_to_github.py
# PAT: github.com/settings/tokens → repo + secrets scope
GITHUB_PAT=
GITHUB_REPO=NipunRaj96/Cheat-Bot